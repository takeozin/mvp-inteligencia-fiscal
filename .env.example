# ============================================================
# ARQUIVO DE EXEMPLO — COPIE PARA .env E PREENCHA COM SEUS DADOS
# JAMAIS COMITE O ARQUIVO .env REAL
# ============================================================

# --- Aplicação ---
APP_ENV=development          # development | production
APP_PORT=5000
APP_SECRET_KEY=TROQUE_POR_UMA_CHAVE_SECRETA_LONGA_E_ALEATORIA

# --- Banco de Dados ---
# Exemplo SQLite (padrão para desenvolvimento local)
DATABASE_URL=sqlite:///instance/fiscal_mvp.db

# Exemplo PostgreSQL (para produção)
# DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# --- Armazenamento de Arquivos ---
# Pasta local para uploads dos SPEDs (nunca versionar o conteúdo desta pasta)
UPLOAD_FOLDER=uploads/
MAX_UPLOAD_SIZE_MB=50

# --- PDF / Relatórios ---
# Caminho para salvar os PDFs gerados (nunca versionar)
RELATORIO_OUTPUT_FOLDER=relatorios/

# --- Segurança ---
# Chave para assinatura de tokens de sessão (gere com: python -c "import secrets; print(secrets.token_hex(32))")
SESSION_SECRET=TROQUE_POR_TOKEN_SEGURO

# --- (Opcional) Integração Futura ---
# SENTRY_DSN=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
